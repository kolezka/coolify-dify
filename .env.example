# =============================================================================
# Dify on Coolify — environment reference
# =============================================================================
# On COOLIFY you normally do NOT need this file. Coolify auto-generates every
# SERVICE_* value below and shows all other variables in the app's
# "Environment Variables" tab, where you can override any of them.
#
# For LOCAL testing without Coolify:
#   1. cp .env.example .env
#   2. change the secrets in the "Secrets" block to your own random strings
#   3. docker compose up -d
#   4. open http://localhost  (add a host port first — see README)
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — Coolify generates these automatically (magic variables).
# For local runs, replace every value with your own long random string.
# The password-style values must NOT contain @ : / so URLs stay valid.
# -----------------------------------------------------------------------------
SERVICE_PASSWORD_POSTGRES=change-me-postgres-password
SERVICE_PASSWORD_REDIS=change-me-redis-password
SERVICE_PASSWORD_WEAVIATE=change-me-weaviate-key
SERVICE_PASSWORD_64_SECRETKEY=change-me-a-long-random-secret-key-at-least-32-chars
SERVICE_PASSWORD_64_PLUGINDAEMON=change-me-a-long-random-plugin-daemon-key
SERVICE_PASSWORD_64_INNERAPI=change-me-a-long-random-inner-api-key
SERVICE_PASSWORD_64_AGENTAPI=change-me-a-long-random-agent-api-token
SERVICE_PASSWORD_64_SHELLCTL=change-me-a-long-random-sandbox-shell-token
# Seed for the agent stub token key (the key itself is derived at startup).
SERVICE_PASSWORD_64_AGENTSECRET=change-me-a-long-random-agent-secret-seed

# The public hostname. On Coolify this is filled from the domain you assign to
# the nginx service. For local runs, set it to localhost.
SERVICE_FQDN_NGINX=localhost

# -----------------------------------------------------------------------------
# Public URLs (optional)
# Leave empty for a single-domain deployment — Dify derives absolute URLs from
# the request. Only set these if share links or uploaded-file URLs come out with
# the wrong scheme/host. Example: https://dify.example.com
# -----------------------------------------------------------------------------
# CONSOLE_API_URL=
# CONSOLE_WEB_URL=
# SERVICE_API_URL=
# APP_API_URL=
# APP_WEB_URL=
# FILES_URL=

# The websocket URL used by the browser for real-time collaboration.
# Defaults to wss://<your-domain>. Use ws://localhost for plain-HTTP local runs.
# NEXT_PUBLIC_SOCKET_URL=ws://localhost

# -----------------------------------------------------------------------------
# First-run admin (optional)
# If set, this becomes the password for the initial admin account instead of
# being chosen on the setup screen.
# -----------------------------------------------------------------------------
# INIT_PASSWORD=

# -----------------------------------------------------------------------------
# Common tunables (optional — safe defaults are baked into docker-compose.yaml)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# NGINX_CLIENT_MAX_BODY_SIZE=100M          # max upload size
# CELERY_WORKER_AMOUNT=1
# SERVER_WORKER_AMOUNT=1

# Vector store — this template ships with Weaviate. Changing the store also
# requires adding its container/config; see the Dify docs.
# VECTOR_STORE=weaviate

# Model provider keys are configured inside the Dify UI after first login,
# not here.
