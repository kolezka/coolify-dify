# Local env (never commit real secrets)
.env
.env.local
*.local

# Local bind-mount data if you run with docker compose locally
volumes/app/
volumes/db/
volumes/redis/
volumes/weaviate/
volumes/plugin_daemon/
volumes/sandbox/dependencies/

# Generated by the nginx entrypoint at runtime (from default.conf.template)
nginx/conf.d/default.conf

